# ── DATABASE (Neon Postgres / Supabase Postgres) ──────────────────────────
# Pooled connection string recommended for serverless deployment
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/glazydb?sslmode=require
DB_POOL_MAX=10

# ── AUTHENTICATION & SECRETS ───────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
COOKIE_SECRET=super_secret_cookie_signing_key_here

# ── INITIAL SEED ADMIN CREDENTIALS ─────────────────────────────────────────
ADMIN_EMAIL=grace@glazydays.com
ADMIN_USERNAME=grace
ADMIN_PASSWORD=change_this_admin_password_on_deploy

# ── APPLICATION SETTINGS ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Manila

# ── CLOUD STORAGE (Optional: Supabase Storage / Cloudinary) ───────────────
# Supabase Storage:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Or Cloudinary:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── CRON SECRET (Protects Vercel Cron endpoints) ──────────────────────────
CRON_SECRET=secure_random_cron_token
